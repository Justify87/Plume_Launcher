<?xml version="1.0" encoding="utf-8"?>
<!-- Sized in dp for a 960x540dp TV canvas (1080p and 4K both map to it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F7">

    <SurfaceView
        android:id="@+id/videoWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">
        <!-- Bottom is a little more than the top: the last text line's box includes space under the letters,
             so this makes the visible gap below Continue Watching match the gap above the clock. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:fontFeatureSettings="tnum"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textSize="48sp" />

                <!-- One line: the date, then a weather icon and the temperature. The weather part is off unless turned on in settings. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:fontFeatureSettings="tnum"
                        android:format12Hour="EEE d MMM"
                        android:format24Hour="EEE d MMM"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- "Featured: a show". Only with the Shows wallpaper: the show whose picture is on screen. -->
                <TextView
                    android:id="@+id/featured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:maxWidth="560dp"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/wifi"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/network_settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_wifi" />

            <ImageView
                android:id="@+id/sourcesButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/sources"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_sources"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/allAppsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/all_apps"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_apps" />

            <ImageView
                android:id="@+id/systemSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />

            <ImageView
                android:id="@+id/launcherSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/plume_settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_tune" />

            <!-- Hidden until it is added from the top bar's menu. -->
            <ImageView
                android:id="@+id/powerButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/act_power"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_power"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- All apps: hidden until the Apps tile is pressed; Back closes it. -->
    <ScrollView
        android:id="@+id/allApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/allAppsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/all_apps"
                android:textSize="20sp" />

            <GridLayout
                android:id="@+id/allAppsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="6" />
        </LinearLayout>
    </ScrollView>

    <!-- Launcher settings: side panel over a dimmed home screen; Back closes it. -->
    <FrameLayout
        android:id="@+id/settingsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:visibility="gone">

        <dev.plume.GlassBox
            android:id="@+id/settingsPanel"
            android:layout_width="440dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="27dp">

            <!-- "Plume settings ›" above a section's title, so you know where Back goes. -->
            <TextView
                android:id="@+id/settingsCrumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/settingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:text="@string/plume_settings"
                android:textSize="24sp" />

            <!-- Scrolls once the rows outgrow the screen; focus moving down scrolls it along. -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- What the focused row does; empty for rows that need no explaining, but always 3 lines tall. -->
            <TextView
                android:id="@+id/settingsHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.15"
                android:ellipsize="end"
                android:maxLines="3"
                android:minLines="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp" />
        </dev.plume.GlassBox>
    </FrameLayout>
</FrameLayout>
